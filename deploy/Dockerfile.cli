# Testing/CLI image variant: bundles Node 22 + @tencent-ai/codebuddy-code
# alongside the CGO-disabled news_panel binary for AI_PROVIDER=cli verification.
# Production/minimal deployments without CLI should continue using root Dockerfile.
FROM node:26-alpine AS frontend
WORKDIR /src/frontend
RUN npm install --global pnpm@10.34.9
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/index.html frontend/tsconfig*.json frontend/vite.config.ts ./
COPY frontend/src ./src
COPY frontend/public ./public
RUN pnpm run build

FROM golang:1.26-alpine AS backend
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/cmd ./cmd
COPY backend/internal ./internal
COPY --from=frontend /src/frontend/dist ./internal/web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /news_panel ./cmd/fusion

FROM node:22-slim
LABEL org.opencontainers.image.title="news_panel-cli-test"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g @tencent-ai/codebuddy-code && npm cache clean --force && \
    groupadd -r news_panel && useradd -r -g news_panel -m -d /home/news_panel news_panel && \
    mkdir -p /data /home/news_panel/.codebuddy && \
    chown -R news_panel:news_panel /data /home/news_panel
COPY --from=backend /news_panel /usr/local/bin/news_panel
COPY LICENSE NOTICE backend/THIRD_PARTY_NOTICES.txt /usr/share/licenses/news_panel/
USER news_panel
WORKDIR /data
VOLUME ["/data"]
ENV DB=/data/news_panel.db \
    HOME=/home/news_panel \
    NODE_OPTIONS=--max-old-space-size=256
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/api/oidc/enabled >/dev/null || exit 1
CMD ["news_panel"]
