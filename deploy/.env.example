# =====================================================================
# news_panel Docker Compose 部署环境变量样例（请勿把真实密钥提交进 Git）
# 使用方式：复制为仓库根目录或 deploy/.env 后填入真实值：
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
# =====================================================================

# ---- 镜像变体选择（支持本地构建或 GHCR 预构建镜像）----
# 方式 1：从 GitHub Container Registry 拉取预构建镜像（推荐，VPS 秒级部署）：
# NEWS_PANEL_IMAGE=ghcr.io/muyukk1/news_panel
# NEWS_PANEL_TAG=latest
# TWIFORK_IMAGE=ghcr.io/muyukk1/news_panel-x-twifork
# TWIFORK_TAG=latest
# （若需在服务端用 CLI 模式，改 NEWS_PANEL_IMAGE=ghcr.io/muyukk1/news_panel-cli）
# 方式 2：本地/本机从 Dockerfile 构建：
# 标准极简镜像（alpine:3.23，推荐用于 OpenAI-compatible HTTP API）：
# NEWS_PANEL_DOCKERFILE=Dockerfile
# CLI 测试镜像（含 Node 22 + codebuddy CLI，仅测试 AI_PROVIDER=cli 时使用）：
NEWS_PANEL_DOCKERFILE=deploy/Dockerfile.cli

# ---- Caddy 反向代理与自动 HTTPS 证书 ----
# 填入已解析到服务器公网 IP 的域名后，Caddy 自动申请/续期 HTTPS 证书并反代到 news-panel:8080；
# 留空或保持 :80 时仅监听 HTTP :80（不申请证书）。
CADDY_DOMAIN=news.example.com

# ---- 核心服务访问与鉴权 ----
NEWS_PANEL_BIND=127.0.0.1
NEWS_PANEL_PORT=8080
FUSION_PASSWORD=change-me-strong-password
INGEST_TOKEN=change-me-plugin-ingest-token

# ---- AI 分拣器配置（模式 A：CodeBuddy CLI 24h 低频模式）----
# 注：实测 deepseek-v4.1-flash 与 hy3 为真正 0 credits（免费）；hy4-flash 约 0.03 credits/次且偶发不遵循纯 JSON；
# deepseek-v4.1-flash-max 当前 CLI 返回 400（不支持），故推荐主模型 deepseek-v4.1-flash、备选 hy3/hy4-flash。
# 非中文条目将在 L2 summary 中自动提炼并翻译为简洁中文。
AI_ENABLED=true
AI_PROVIDER=cli
AI_CLI_COMMAND=codebuddy
AI_CLI_ARGS=-p,{{prompt}},--tools,"",--model,deepseek-v4.1-flash,--fallback-model,hy3,--no-session-persistence,--output-format,json
AI_TIMEOUT_SECONDS=90
# 微型 VPS（如 0.25 vCPU 突发型 e2-micro）建议设置冷却间隔，避免连续冷启动耗尽 CPU 突发额度导致超时：
AI_CLI_COOLDOWN_SECONDS=20
AI_HTTP_WRITE_TIMEOUT_SECONDS=480
AI_KEEP_MIN_SCORE=45
AI_FALLBACK_MODE=keep_l1
AI_L1_FILTER_RETWEETS=true
# 可选覆盖 L1 屏蔽/放行关键词或自定义关注主题（逗号分隔）：
# AI_TOPICS=AI,大模型,开发工具,效率工具,优惠/Bug价
# AI_L1_BLOCK_KEYWORDS=
# AI_L1_ALLOW_KEYWORDS=

# 可选 L2 云端决策门控。缺省不填凭证或端点时，L1 放行后直接进入主模型。
# 留空自动探测，false 强制关闭
# AI_DECISION_ENABLED=
# openai、http_json、off（或 none）
# AI_DECISION_PROVIDER=openai
# openai 缺省使用 https://api.openai.com/v1，http_json 填完整 POST 地址
# AI_DECISION_BASE_URL=
# 独立门控密钥，openai 必填，http_json 可选
# AI_DECISION_API_KEY=
# http_json 鉴权头名。Authorization 自动为裸密钥添加 Bearer 前缀，自定义头原样发送
# AI_DECISION_AUTH_HEADER=Authorization
# L2 请求中的 model
# AI_DECISION_MODEL=gpt-4o-mini
# 在 L2 OpenAI-compatible 请求中指定 json_object
# AI_DECISION_JSON_FORMAT=false
# L2 单次 HTTP 调用超时秒数
# AI_DECISION_TIMEOUT_SECONDS=6
# 放行后进入 L3 的优先级
# AI_DECISION_L3_PRIORITIES=critical,high,normal
# 未达 L3 门槛时保留为未打分，设 filter 则拦截
# AI_DECISION_LOW_ACTION=keep_unscored
# L2 异常时直通 L3，也可选 keep_l1 或 fail
# AI_DECISION_FALLBACK_MODE=skip_to_l3
# 每个开启 AI 的 RSS 源单轮最多评估的新条目数，0 为不限
# AI_RSS_MAX_ITEMS_PER_PULL=20
CODEBUDDY_AUTH_TOKEN=
# WorkBuddy 国际版 OAuth Token 在海外云节点（如 GCP）建议显式指定 API 基址并关闭冗余遥测（避免 10s OTLP 超时）：
CODEBUDDY_BASE_URL=https://www.workbuddy.ai/v2
CODEBUDDY_REMOTE_CONFIG_DISABLED=1
CODEBUDDY_DISABLE_TRACE_COLLECTOR=1
CODEBUDDY_DISABLE_AUTO_MEMORY=1
CODEBUDDY_DISABLE_GIT_PROMPT_CONTEXT=1
OTEL_TRACES_EXPORTER=none

# ---- AI 分拣器配置（模式 B：标准 OpenAI-compatible API，推荐日常常驻）----
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=8

# ---- X (Twitter) 备用小号 Cookie（plugins/x-twifork）----
X_AUTH_TOKEN=
X_CT0=
X_TWID=
