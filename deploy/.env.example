# =====================================================================
# news_panel Docker Compose 部署环境变量样例（请勿把真实密钥提交进 Git）
# 使用方式：复制为仓库根目录或 deploy/.env 后填入真实值：
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
# =====================================================================

# ---- 镜像变体选择 ----
# 标准极简镜像（alpine:3.23，推荐用于 OpenAI-compatible HTTP API）：
# NEWS_PANEL_DOCKERFILE=Dockerfile
# CLI 测试镜像（含 Node 22 + codebuddy CLI，仅测试 AI_PROVIDER=cli 时使用）：
NEWS_PANEL_DOCKERFILE=deploy/Dockerfile.cli

# ---- 核心服务访问与鉴权 ----
NEWS_PANEL_BIND=127.0.0.1
NEWS_PANEL_PORT=8080
FUSION_PASSWORD=change-me-strong-password
INGEST_TOKEN=change-me-plugin-ingest-token

# ---- AI 分拣器配置（模式 A：CodeBuddy CLI 测试）----
AI_ENABLED=true
AI_PROVIDER=cli
AI_CLI_COMMAND=codebuddy
AI_CLI_ARGS=-p,{{prompt}},--tools,"",--model,fast-model,--no-session-persistence,--output-format,json
AI_TIMEOUT_SECONDS=25
AI_HTTP_WRITE_TIMEOUT_SECONDS=180
AI_KEEP_MIN_SCORE=45
AI_FALLBACK_MODE=keep_l1
CODEBUDDY_AUTH_TOKEN=

# ---- AI 分拣器配置（模式 B：标准 OpenAI-compatible API，推荐日常常驻）----
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=8

# ---- X (Twitter) 备用小号 Cookie（plugins/x-twifork）----
X_AUTH_TOKEN=
X_CT0=
X_TWID=
